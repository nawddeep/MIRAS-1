{
  "name": "miras-capture-pwa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform Progressive Web App for MIRAS 360° heritage photography, on-device stitching, hotspot authoring, and MIRAS package export.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src",
    "perf": "node scripts/perf.mjs",
    "bench:quality": "QUALITY=1 vitest run tests/stitch-quality.test.ts",
    "bench:real": "vitest run tests/real-scene.test.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.1.4"
  }
}
