# Copy to .env (backend reads ./.env or ../.env). Never commit .env.
# Every key is optional: a missing key shows as "not configured" and the next provider is tried.

# ---------- Backend (server-side only) ----------
DATABASE_URL=sqlite:///data/itinerary.db
CORS_ORIGINS=http://localhost:3000

# Priority 1
GOOGLE_MAPS_SERVER_KEY=          # Places API (New) + Routes API. Restrict by IP; never expose to browsers.
GEOAPIFY_API_KEY=                # Places + geocoding/autocomplete (3,000 free credits/day)
NOMINATIM_USER_AGENT=            # e.g. "TripTrail/0.1 (you@example.com)". Required by the Nominatim policy.
OPENROUTESERVICE_API_KEY=                # Routing fallback with elevation
OSRM_BASE_URL=https://routing.openstreetmap.de

# Priority 2
SERPAPI_API_KEY=                # Google Flights offers
AVIATIONSTACK_API_KEY=                # Future schedules (flightsFuture needs a paid plan)
DUFFEL_API_KEY=                  # Airline offers (search only, never orders)
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_TRAIN_RESOURCE_ID=   # Resource id of the railway timetable dataset you use
GTFS_BUS_FEED_DIR=               # Folder with an unzipped, authorised GTFS feed

# ---------- Frontend (frontend/.env.local) ----------
# BACKEND_URL=http://127.0.0.1:8000           # server-side only, used by the /api proxy
# NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=         # optional. A browser key by design: restrict it to your
#                                              # domains and the Maps JavaScript API only. Without it the
#                                              # map uses Leaflet + OpenStreetMap tiles.

# Suggestion quality (Google places only; OpenStreetMap has no ratings)
MIN_RATING=4.0
MIN_REVIEWS=20
HIDDEN_GEM_SHARE=0.34
DAY_RADIUS_M=2500

# Travel modes: without Google Routes, two-wheeler time = car time x this factor (labelled "Estimated")
TWO_WHEELER_FACTOR=0.85
GOOGLE_ROUTES_TRAFFIC_AWARE=false

# OpenStreetMap Overpass servers (comma-separated, tried in order)
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter

# Developer-only /api/debug/explain. Never true in production.
DEBUG_ENDPOINTS=false
